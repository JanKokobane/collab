```env
NODE_ENV=development
PORT=3000

# PostgreSQL (TLS certificate verification is enforced by the backend)
DB_HOST=your-neon-host
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-neon-password

# Optional TURN relay for WebRTC calls. Set up Coturn with REST API shared-secret auth.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_SHARED_SECRET=

# Optional Metered.ca TURN credentials; preferred when both values are configured.
METERED_APP_NAME=
METERED_API_KEY=

# Firebase
FIREBASE_PROJECT_ID=collab-5a8c2
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# CORS
# Use * for any frontend host, or a comma-separated exact-origin allowlist.
CORS_ALLOWED_ORIGINS=*

# Frontend / API
FRONTEND_URL=https://your-deployed-frontend.example
PUBLIC_API_URL=https://collab-y7pb.onrender.com
